<!DOCTYPE html>
<html>
<head><title>Editar Regla de Precio</title></head>
<body>
  <h2>Editar Regla de Precio</h2>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/pricing-rules/update/<%= rule._id %>" method="POST">
    <label>Nombre:</label> <input type="text" name="nombre" value="<%= rule.nombre %>" required><br><br>
    
    <label>Tipo:</label>
    <select name="tipo" required>
      <option value="horario" <%= rule.tipo === 'horario' ? 'selected' : '' %>>Horario</option>
      <option value="categoria_barbero" <%= rule.tipo === 'categoria_barbero' ? 'selected' : '' %>>Categoría de Barbero</option>
      <option value="temporada" <%= rule.tipo === 'temporada' ? 'selected' : '' %>>Temporada</option>
    </select><br><br>

    <label>Condición:</label> <input type="text" name="condicion" value="<%= rule.condicion %>" required><br><br>
    <label>Factor:</label> <input type="number" name="factor" step="0.01" min="-0.5" max="1.0" value="<%= rule.factor %>" required><br><br>

    <label>Temporada:</label>
    <select name="temporada">
      <option value="">-- Ninguna --</option>
      <% seasons.forEach(s => { %>
        <option value="<%= s._id %>" <%= (rule.temporada && rule.temporada.toString() === s._id.toString()) ? 'selected' : '' %>><%= s.nombre %></option>
      <% }) %>
    </select><br><br>

    <label>Descripción:</label> <input type="text" name="descripcion" value="<%= rule.descripcion || '' %>"><br><br>
    <button type="submit">Actualizar</button>
  </form>
  <br>
  <a href="/pricing-rules">Volver</a>
</body>
</html>
