<!DOCTYPE html>
<html>
<head><title>Reglas de Precio</title></head>
<body>
  <h2>Reglas de Precio</h2>
  <p>Bienvenido, <strong><%= user %></strong> | 
    <a href="/services">Servicios</a> | 
    <a href="/barbers">Barberos</a> | 
    <a href="/seasons">Temporadas</a> | 
    <a href="/pricing-rules">Reglas de Precio</a> | 
    <a href="/pricing">Cotizador</a> | 
    <a href="/auth/logout">Cerrar Sesión</a>
  </p>
  <hr>
  <a href="/pricing-rules/new">Crear Nueva Regla</a>
  <br><br>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Condición</th>
        <th>Factor</th>
        <th>Temporada Asociada</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% rules.forEach(r => { %>
        <tr>
          <td><%= r.nombre %></td>
          <td><%= r.tipo %></td>
          <td><%= r.condicion %></td>
          <td><%= (r.factor * 100).toFixed(0) %>%</td>
          <td><%= r.temporada ? r.temporada.nombre : '-' %></td>
          <td>
            <a href="/pricing-rules/edit/<%= r._id %>">Editar</a>
            <form action="/pricing-rules/delete/<%= r._id %>" method="POST" style="display:inline;">
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
