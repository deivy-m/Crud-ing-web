<!DOCTYPE html>
<html>
<head><title>Nueva Regla de Precio</title></head>
<body>
  <h2>Crear Regla de Precio</h2>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/pricing-rules" method="POST">
    <label>Nombre:</label> <input type="text" name="nombre" required><br><br>
    
    <label>Tipo:</label>
    <select name="tipo" required>
      <option value="">-- Seleccionar --</option>
      <option value="horario">Horario</option>
      <option value="categoria_barbero">Categoría de Barbero</option>
      <option value="temporada">Temporada</option>
    </select><br><br>

    <label>Condición:</label> <input type="text" name="condicion" placeholder="ej: hora_pico, master" required><br><br>
    <label>Factor (ej: 0.20):</label> <input type="number" name="factor" step="0.01" min="-0.5" max="1.0" required><br><br>

    <label>Temporada (si aplica):</label>
    <select name="temporada">
      <option value="">-- Ninguna / No aplica --</option>
      <% seasons.forEach(s => { %>
        <option value="<%= s._id %>"><%= s.nombre %></option>
      <% }) %>
    </select><br><br>

    <label>Descripción:</label> <input type="text" name="descripcion"><br><br>
    <button type="submit">Guardar</button>
  </form>
  <br>
  <a href="/pricing-rules">Volver</a>
</body>
</html>
