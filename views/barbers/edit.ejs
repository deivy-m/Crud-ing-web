<!DOCTYPE html>
<html>
<head><title>Editar Barbero</title></head>
<body>
  <h2>Editar Barbero</h2>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/barbers/update/<%= barber._id %>" method="POST">
    <label>Nombre:</label> <input type="text" name="nombre" value="<%= barber.nombre %>" required><br><br>
    <label>Cédula:</label> <input type="text" name="cedula" maxlength="10" value="<%= barber.cedula %>" required><br><br>
    <label>Email:</label> <input type="email" name="email" value="<%= barber.email %>" required><br><br>
    <label>Teléfono:</label> <input type="text" name="telefono" value="<%= barber.telefono %>" required><br><br>
    <label>Categoría:</label>
    <select name="categoria" required>
      <option value="Junior" <%= barber.categoria === 'Junior' ? 'selected' : '' %>>Junior</option>
      <option value="Senior" <%= barber.categoria === 'Senior' ? 'selected' : '' %>>Senior</option>
      <option value="Master" <%= barber.categoria === 'Master' ? 'selected' : '' %>>Master</option>
    </select><br><br>
    <button type="submit">Actualizar</button>
  </form>
  <br>
  <a href="/barbers">Volver</a>
</body>
</html>
