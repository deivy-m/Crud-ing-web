<!DOCTYPE html>
<html>
<head><title>Nuevo Barbero</title></head>
<body>
  <h2>Registrar Barbero</h2>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/barbers" method="POST">
    <label>Nombre:</label> <input type="text" name="nombre" value="<%= (typeof data !== 'undefined' && data.nombre) || '' %>" required><br><br>
    <label>Cédula:</label> <input type="text" name="cedula" maxlength="10" value="<%= (typeof data !== 'undefined' && data.cedula) || '' %>" required><br><br>
    <label>Email:</label> <input type="email" name="email" value="<%= (typeof data !== 'undefined' && data.email) || '' %>" required><br><br>
    <label>Teléfono:</label> <input type="text" name="telefono" value="<%= (typeof data !== 'undefined' && data.telefono) || '' %>" required><br><br>
    <label>Categoría:</label>
    <select name="categoria" required>
      <option value="">-- Seleccionar --</option>
      <option value="Junior" <%= (typeof data !== 'undefined' && data.categoria === 'Junior') ? 'selected' : '' %>>Junior</option>
      <option value="Senior" <%= (typeof data !== 'undefined' && data.categoria === 'Senior') ? 'selected' : '' %>>Senior</option>
      <option value="Master" <%= (typeof data !== 'undefined' && data.categoria === 'Master') ? 'selected' : '' %>>Master</option>
    </select><br><br>
    <button type="submit">Guardar</button>
  </form>
  <br>
  <a href="/barbers">Volver</a>
</body>
</html>
