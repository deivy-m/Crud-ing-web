<!DOCTYPE html>
<html>
<head><title>Barberos</title></head>
<body>
  <h2>Gestión de Barberos</h2>
  <p>Bienvenido, <strong><%= user %></strong> | 
    <a href="/services">Servicios</a> | 
    <a href="/barbers">Barberos</a> | 
    <a href="/seasons">Temporadas</a> | 
    <a href="/pricing-rules">Reglas de Precio</a> | 
    <a href="/pricing">Cotizador</a> | 
    <a href="/auth/logout">Cerrar Sesión</a>
  </p>
  <hr>
  <a href="/barbers/new">Registrar Nuevo Barbero</a>
  <br><br>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Cédula</th>
        <th>Email</th>
        <th>Teléfono</th>
        <th>Categoría</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% barbers.forEach(b => { %>
        <tr>
          <td><%= b.nombre %></td>
          <td><%= b.cedula %></td>
          <td><%= b.email %></td>
          <td><%= b.telefono %></td>
          <td><%= b.categoria %></td>
          <td>
            <a href="/barbers/edit/<%= b._id %>">Editar</a>
            <form action="/barbers/delete/<%= b._id %>" method="POST" style="display:inline;">
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
