<!DOCTYPE html>
<html>
<head><title>Editar Temporada</title></head>
<body>
  <h2>Editar Temporada</h2>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/seasons/update/<%= season._id %>" method="POST">
    <label>Nombre:</label> <input type="text" name="nombre" value="<%= season.nombre %>" required><br><br>
    <label>Fecha Inicio:</label> <input type="date" name="fechaInicio" value="<%= new Date(season.fechaInicio).toISOString().split('T')[0] %>" required><br><br>
    <label>Fecha Fin:</label> <input type="date" name="fechaFin" value="<%= new Date(season.fechaFin).toISOString().split('T')[0] %>" required><br><br>
    <label>Factor:</label> <input type="number" name="factorPrecio" step="0.01" min="-0.5" max="1.0" value="<%= season.factorPrecio %>" required><br><br>
    <button type="submit">Actualizar</button>
  </form>
  <br>
  <a href="/seasons">Volver</a>
</body>
</html>
