<!DOCTYPE html>
<html>
<head><title>Temporadas</title></head>
<body>
  <h2>Gestión de Temporadas</h2>
  <p>Bienvenido, <strong><%= user %></strong> | 
    <a href="/services">Servicios</a> | 
    <a href="/barbers">Barberos</a> | 
    <a href="/seasons">Temporadas</a> | 
    <a href="/pricing-rules">Reglas de Precio</a> | 
    <a href="/pricing">Cotizador</a> | 
    <a href="/auth/logout">Cerrar Sesión</a>
  </p>
  <hr>
  <a href="/seasons/new">Crear Nueva Temporada</a>
  <br><br>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Fecha Inicio</th>
        <th>Fecha Fin</th>
        <th>Factor</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% seasons.forEach(s => { %>
        <tr>
          <td><%= s.nombre %></td>
          <td><%= new Date(s.fechaInicio).toLocaleDateString('es-EC') %></td>
          <td><%= new Date(s.fechaFin).toLocaleDateString('es-EC') %></td>
          <td><%= (s.factorPrecio * 100).toFixed(0) %>%</td>
          <td>
            <a href="/seasons/edit/<%= s._id %>">Editar</a>
            <form action="/seasons/delete/<%= s._id %>" method="POST" style="display:inline;">
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
