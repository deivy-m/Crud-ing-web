<!DOCTYPE html>
<html>
<head><title>Nueva Temporada</title></head>
<body>
  <h2>Crear Temporada</h2>
  <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form action="/seasons" method="POST">
    <label>Nombre:</label> <input type="text" name="nombre" required><br><br>
    <label>Fecha Inicio:</label> <input type="date" name="fechaInicio" required><br><br>
    <label>Fecha Fin:</label> <input type="date" name="fechaFin" required><br><br>
    <label>Factor (ej: 0.10 para +10%):</label> <input type="number" name="factorPrecio" step="0.01" min="-0.5" max="1.0" required><br><br>
    <button type="submit">Guardar</button>
  </form>
  <br>
  <a href="/seasons">Volver</a>
</body>
</html>
